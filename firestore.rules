rules_version = '2';

// 우마시 Firestore 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에 통째로 붙여넣고 [게시]를 누르세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 선생님 = 이 기기(uid)의 선생님 표시에 적힌 비밀번호가 지금 비밀번호와 같을 때
    // (비밀번호를 바꾸면 다른 기기의 선생님 모드는 자동으로 풀림)
    function isTeacher(classId) {
      return signedIn()
        && exists(/databases/$(database)/documents/classes/$(classId)/teacherSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/classes/$(classId)/teacherSessions/$(request.auth.uid)).data.pw
           == get(/databases/$(database)/documents/classes/$(classId)/private/teacher).data.pw;
    }

    function isPw(v) {
      return v is string && v.size() >= 4 && v.size() <= 30;
    }

    function isName(v) {
      return v is string && v.size() > 0 && v.size() <= 20;
    }

    // 소감 문서 모양 검사
    function validFeedback(d) {
      return d.keys().hasOnly(['to', 'from', 'uid', 'emoji', 'label', 'categories', 'comment',
                               'status', 'editedBy', 'legacyTime', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['to', 'from', 'uid', 'emoji', 'label', 'categories', 'comment', 'status'])
        && isName(d.to)
        && isName(d.from)
        && d.uid is string
        && d.emoji is string && d.emoji.size() <= 8
        && d.label is string && d.label.size() <= 20
        && d.categories is list && d.categories.size() >= 1 && d.categories.size() <= 5
        && d.comment is string && d.comment.size() >= 1 && d.comment.size() <= 80
        && d.status in ['normal', 'rejected', 'revised'];
    }

    // 학급 설정 (명단 + 열람 허용)
    match /classes/{classId} {
      allow read: if signedIn();
      allow write: if isTeacher(classId);

      // 학생: 처음 들어올 때 자기 이름 한 명을 명단에 추가하는 것만 가능
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['students'])
        && request.resource.data.students is list
        && request.resource.data.students.size() == 1;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['students'])
        && request.resource.data.students is list
        && request.resource.data.students.hasAll(resource.data.students)
        && request.resource.data.students.size() == resource.data.students.size() + 1;

      // 소감 (1개 = 문서 1개)
      match /feedbacks/{fid} {
        allow read: if signedIn();

        // 선생님: 무엇이든 (모양 검사는 통과해야 함)
        allow create, update: if isTeacher(classId) && validFeedback(request.resource.data);
        allow delete: if isTeacher(classId);

        // 학생: 자기 이름표(uid)로만 새로 쓰기
        // 문서 이름이 '보낸사람__받는사람'이어야 함 → 한 친구에게 마음은 한 번만
        allow create: if signedIn()
          && fid == request.resource.data.from + '__' + request.resource.data.to
          && validFeedback(request.resource.data)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.to != request.resource.data.from
          && request.resource.data.status == 'normal'
          && request.resource.data.createdAt == request.time;

        // 학생: 자기가 쓴 글만 고치기 (받는 친구·보낸 이름·상태는 마음대로 못 바꿈)
        allow update: if signedIn()
          && resource.data.uid == request.auth.uid
          && validFeedback(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['emoji', 'label', 'categories', 'comment', 'status', 'editedBy', 'updatedAt'])
          && (
               (request.resource.data.status == resource.data.status && resource.data.status != 'rejected')
               || (resource.data.status == 'rejected' && request.resource.data.status == 'revised')
             );

        // 학생: 자기가 쓴 글만 지우기
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      // 선생님 비밀번호 — 아무도 읽을 수 없음. 처음 한 번만 만들 수 있고, 이후엔 선생님만 바꿀 수 있음
      match /private/teacher {
        allow read, delete: if false;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['pw'])
          && isPw(request.resource.data.pw);
        allow update: if isTeacher(classId)
          && request.resource.data.keys().hasOnly(['pw'])
          && isPw(request.resource.data.pw);
      }

      // 선생님 모드 표시 (기기별). 비밀번호가 맞아야만 만들 수 있음
      match /teacherSessions/{uid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['pw', 'at'])
          && request.resource.data.at == request.time
          && request.resource.data.pw == get(/databases/$(database)/documents/classes/$(classId)/private/teacher).data.pw;
      }
    }

    // 이전 버전 데이터 — 선생님만 읽기 (가져오기 기능용). 옮긴 뒤에는 지워도 됩니다.
    match /artifacts/{appId}/public/data/{rest=**} {
      allow read: if isTeacher(appId);
      allow write: if false;
    }
  }
}
